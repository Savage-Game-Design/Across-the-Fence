class FSM
{
        fsmName = "patrol";
        class States
        {
                /*%FSM<STATE "INIT">*/
                class INIT
                {
                        name = "INIT";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"/* PATROL.fsm" \n
                         "	Author: Phronk" \n
                         "	Description: To be used on agents for continuous movements. Agents don't have waypoints," \n
                         "	so we must use an FSM to handle their movements. Simply tells the agent to move to" \n
                         "	predetermined positions passed to this FSM so it can be used more broadly." \n
                         "*/" \n
                         "params[""_a"",""_wpList""];" \n
                         "" \n
                         "_wp = _wpList # 0;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "dead">*/
                                class dead
                                {
                                        itemno = 6;
                                        priority = 9.000000;
                                        to="null";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isNull _a || !alive _a"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"//systemChat ""dead/null: exiting"";"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "alive">*/
                                class alive
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="main";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(!(isNull _a)) && alive _a"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "moveTo">*/
                class moveTo
                {
                        name = "moveTo";
                        itemno = 1;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "//systemChat ""wpMoveTo"";" \n
                         "" \n
                         "_a moveTo _wp;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "wpDone">*/
                                class wpDone
                                {
                                        itemno = 5;
                                        priority = 5.000000;
                                        to="main";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _t+15 && { speed _a == 0 || { moveToCompleted _a || { moveToFailed _a } } }"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"//Push 0 index wp to the rear of array" \n
                                         "//systemChat ""wpDone"";" \n
                                         "" \n
                                         "private _wpList = _wpList - [ _wp ];" \n
                                         "private _wpList = _wpList + [ _wp ];"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "despawn">*/
                                class despawn
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="EXIT_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_wpList isEqualTo [] || { isNull _a || { !alive _a } }"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"//systemChat ""despawn"";"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "wpWIP">*/
                                class wpWIP
                                {
                                        itemno = 2;
                                        priority = 0.000000;
                                        to="moveTo";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _t+15 && speed _a > 0"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"_a moveTo _wp;" \n
                                         "//systemChat ""wpWIP"";"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "main">*/
                class main
                {
                        name = "main";
                        itemno = 3;
                        init = /*%FSM<STATEINIT""">*/"_t = time;" \n
                         "" \n
                         "//systemChat ""main"";" \n
                         "private _wp = _wpList # 0;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "__hasWP">*/
                                class __hasWP
                                {
                                        itemno = 10;
                                        priority = 9.000000;
                                        to="EXIT";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_wpList isEqualTo []"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"//systemChat ""!hasWP: exiting"";"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "hasWP">*/
                                class hasWP
                                {
                                        itemno = 4;
                                        priority = 0.000000;
                                        to="moveTo";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_wpList isNotEqualTo []"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"//systemChat ""hasWP"";"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "null">*/
                class null
                {
                        name = "null";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "EXIT">*/
                class EXIT
                {
                        name = "EXIT";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "EXIT_1">*/
                class EXIT_1
                {
                        name = "EXIT_1";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="INIT";
        finalStates[] =
        {
                "null",
                "EXIT",
                "EXIT_1",
        };
};
/*%FSM</COMPILE>*/