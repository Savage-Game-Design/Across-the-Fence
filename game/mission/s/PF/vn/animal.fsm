class FSM
{
        fsmName = "animal";
        class States
        {
                /*%FSM<STATE "INIT">*/
                class INIT
                {
                        name = "INIT";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"//params[""_b"",""_f""];" \n
                         "//private _pos = getPosATL _b;" \n
                         "" \n
                         "" \n
                         "private _t = diag_tickTime;" \n
                         "" \n
                         "if ( isNil ""PF_Ambient"" ) then" \n
                         "{" \n
                         "	PF_Ambient = [];" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 7;
                                        priority = 0.000000;
                                        to="INIT_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "wander">*/
                class wander
                {
                        name = "wander";
                        itemno = 1;
                        init = /*%FSM<STATEINIT""">*/"//Instruct AI to wander"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "move">*/
                                class move
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="delay";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"diag_tickTime > _t+3"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"//Animals wander within 3m of _pos (For each object w/ AI)" \n
                                         "" \n
                                         "PF_Ambient select { ( { !isNull _x && { alive _x } } count (_x#2) ) > 0 };" \n
                                         "" \n
                                         "{" \n
                                         "	//Object" \n
                                         "//	private _o = _x#0;" \n
                                         "" \n
                                         "	private _id = (_x#1);" \n
                                         "" \n
                                         "	private _ai = (_x#2) select{ ( !isNull _x && { alive _x } ) };" \n
                                         "" \n
                                         "	//Obtain index of correct object w/ animals" \n
                                         "	private _i = PF_MapObjs findIf { _id isEqualTo (_x#1) };" \n
                                         "" \n
                                         "" \n
                                         "	//Obtain correct object w/ animals" \n
                                         "	private _o = ( PF_MapObjs # _i ) # 0;" \n
                                         "" \n
                                         "" \n
                                         "	//Center position of object" \n
                                         "	private _pos = getPosATL _o;" \n
                                         "" \n
                                         "	//Gather animals" \n
                                         "	systemChat format [""_animals = %1"",_ai];" \n
                                         "	{" \n
                                         "		private _xyz = _pos getPos [ 2.5 , random 359 ];" \n
                                         "		_x setDestination [ _xyz , ""LEADER PLANNED"" , true ];" \n
                                         "	}forEach _ai" \n
                                         "}forEach PF_Ambient;" \n
                                         "" \n
                                         "//_arr"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "INIT_1">*/
                class INIT_1
                {
                        name = "INIT_1";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"private _t = diag_tickTime;" \n
                         "" \n
                         "//Refresh array of objects w/ animals, eliminating objNull or !alive" \n
                         "private _delete = PF_Ambient select { ( { isNull _x && { !alive _x } } count (_x#2) ) > 0 };" \n
                         "" \n
                         "{" \n
                         "	if ( ( { ( isNull _x && { !alive _x } ) } count (_x#2) ) == (count(_x#2))) then" \n
                         "	{" \n
                         "		PF_Ambient = PF_Ambient - [ _x ];" \n
                         "	};" \n
                         "}forEach PF_Ambient;" \n
                         "" \n
                         "//private _arr = PF_Ambient select { ( { alive _x } count (_x#2) ) > 0 };"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "noAI">*/
                                class noAI
                                {
                                        itemno = 3;
                                        priority = 7.000000;
                                        to="WAIT";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"//_arr isEqualTo []" \n
                                         "" \n
                                         "PF_Ambient isEqualTo []"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"private _t = diag_tickTime;"/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Animals">*/
                                class Animals
                                {
                                        itemno = 4;
                                        priority = 5.000000;
                                        to="wander";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"//If objects w/ animals exist, proceed..." \n
                                         "//_arr isNotEqualTo []" \n
                                         "" \n
                                         "PF_Ambient isNotEqualTo []"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "WAIT">*/
                class WAIT
                {
                        name = "WAIT";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "__0s">*/
                                class __0s
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="INIT_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"diag_tickTime > _t+10"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "delay">*/
                class delay
                {
                        name = "delay";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/"//Do nothing"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "__0s">*/
                                class __0s
                                {
                                        itemno = 10;
                                        priority = 1.000000;
                                        to="INIT_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"diag_tickTime > _t+20"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="INIT";
        finalStates[] =
        {
        };
};
